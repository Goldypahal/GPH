# ==============================================================================
# GIVIN Local Development & Sandbox Secret Template
# WARNING: DO NOT COMMIT REAL CREDENTIALS OR APPLY TO PRODUCTION CLUSTERS!
# For production, use External Secrets Operator + HashiCorp Vault.
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: givin-secrets
  namespace: givin-system
  labels:
    app.kubernetes.io/name: givin
    app.kubernetes.io/environment: local-development-only
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME_LOCAL_DEV_DB_PASSWORD"
  JWT_SECRET: "CHANGE_ME_LOCAL_DEV_JWT_SECRET_AT_LEAST_32_CHARS"
  SECRET_KEY: "CHANGE_ME_LOCAL_DEV_SECRET_KEY_AT_LEAST_32_CHARS_LONG"
  MINIO_ROOT_USER: "minio_local_dev"
  MINIO_ROOT_PASSWORD: "CHANGE_ME_LOCAL_DEV_MINIO_PASSWORD"
  MINIO_SECRET_KEY: "CHANGE_ME_LOCAL_DEV_MINIO_PASSWORD"
  HMAC_SIGNING_KEY: "CHANGE_ME_LOCAL_DEV_HMAC_KEY"
