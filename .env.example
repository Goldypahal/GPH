# =====================================================================
# GIVIN — Gujarat Integrated Video Intelligence Network
# Canonical Environment Configuration Template (.env.example)
# =====================================================================

# Platform Identity & Deployment Environment
PROJECT_NAME="GIVIN - Gujarat Integrated Video Intelligence Network"
ENVIRONMENT=development
SECRET_KEY=local-development-only-change-me

# Relational & Spatial Database (SQLite for dev, PostgreSQL+PostGIS for prod)
DATABASE_URL=sqlite:///./givin.db

# In-Memory Cache & Ephemeral State
REDIS_URL=redis://localhost:6379/0

# Distributed Event Streaming (Apache Kafka / Redpanda)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Object & Forensic Evidence Storage (local | minio | s3)
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=givinadmin
MINIO_SECRET_KEY=change-this-development-password
MINIO_SECURE=false
MINIO_BUCKET_EVIDENCE=givin-evidence

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Edge AI & Vision Pipeline Configuration
GIVIN_VISION_MODE=auto
GIVIN_STREAM_MODE=real
GIVIN_VEHICLE_MODEL=yolo11n.pt
GIVIN_PLATE_MODEL=models/anpr_plate_detector.pt
GIVIN_OCR_MODEL=paddleocr
GIVIN_TRACKER_TYPE=bytetrack
GIVIN_TEMPORAL_FUSION_WINDOW=10
GIVIN_EVIDENCE_DIR=data/evidence

# Enterprise Security & OIDC SSO (State Data Centre / Keycloak)
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://sso.gujarat.gov.in/auth/realms/gujarat-police
OIDC_CLIENT_ID=givin-c4i-platform
DEV_BYPASS_TOKEN=givin-local-dev-bypass-2026

# Velocity Physics & Spatiotemporal Anomaly Thresholds
IMPOSSIBLE_SPEED_THRESHOLD_KMH=180.0
SUSPICIOUS_SPEED_THRESHOLD_KMH=130.0
